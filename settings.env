# Strategy settings. Edit this file on GitHub, then run the 2 install lines on the server.
# Your RSI rule stays exactly as you defined it. The other filters are made easier.

# ---- your rule ----
RSI_SHORT_LEVEL=80
RSI_LONG_LEVEL=30
RSI_LONG_STRONG=25

# ---- 4H zones ----
# 2 = zone needs 2 reasons (e.g. equal highs, or PDH, or order block). 1 = any swing point counts.
MIN_ZONE_STRENGTH=2
# how close to the zone price must be (in 4H candle sizes). Was 0.3
ZONE_PROXIMITY_ATR=0.5
# how far the sweep may go through the zone. Was 0.6
MAX_OVERSHOOT_ATR=0.8

# ---- 5m candle and volume ----
# big candle = body at least X times a normal 5m candle. Was 1.5
BIG_CANDLE_ATR=1.2
# or 2-3 candles together moved X times a normal candle. Was 2.0
PUSH_ATR=1.5
# SHORT: price must be in the top part of the candle (0.6 = top 40%). Was 0.7
UPPER_PART=0.6
# sweep candle volume at least X times the average. Was 1.5
VOL_EXPANSION_MULT=1.2
# LONG reclaim candle volume. Was 1.0
RECLAIM_VOL_MULT=0.8
# 4H volume above X times normal = climax, no signal. Was 2.5
HTF_CLIMAX_VOL_MULT=3

# ---- coins ----
MIN_24H_VOLUME_USDT=20000000

# ---- Telegram status report every X hours (0 = off) ----
STATUS_HOURS=6
