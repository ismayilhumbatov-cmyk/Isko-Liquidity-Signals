# Copy this file to .env and fill in your values.  NEVER commit .env to GitHub.
# SIGNAL-ONLY bot: no Binance API keys are needed and no orders are ever placed.

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = also message when a LONG sweep is being watched (before the entry signal)
NOTIFY_ARMED=false

# ---------- coins ----------
# true = scan ALL Binance USDT perpetual crypto coins (stablecoins always removed)
SCAN_ALL=true
# only coins with at least this much traded in the last 24h (USDT) get scanned and signalled
MIN_24H_VOLUME_USDT=20000000
# how often the coin list is refreshed (minutes): new active coins added, quiet coins removed
PAIR_REFRESH_MIN=60
# 0 = no limit; e.g. 150 = only the 150 biggest coins that pass the volume rule
MAX_PAIRS=0
# used only when SCAN_ALL=false
PAIRS=BTCUSDT,ETHUSDT,SOLUSDT
EXCLUDE_PAIRS=

# ---------- shown in each signal ----------
RISK_PCT=1
LEVERAGE=10
# skip setups whose stop is wider than this %
MAX_SL_PCT=4

# ---------- 4H zones ----------
MIN_ZONE_STRENGTH=2
# 4H candle volume above 2.5x average = climax, no signal
HTF_CLIMAX_VOL_MULT=2.5

# ---------- 5m entries ----------
RSI_SHORT_LEVEL=80
RSI_LONG_LEVEL=30
RSI_LONG_STRONG=25
# big candle = body at least 1.5x the normal 5m candle size (ATR)
BIG_CANDLE_ATR=1.5
# sweep candle volume at least 1.5x the 20-candle average
VOL_EXPANSION_MULT=1.5
RECLAIM_VOL_MULT=1.0
# LONG: wait max 6 candles (30 min) for the reclaim candle
ARM_EXPIRY_BARS=6

# ---------- stops / targets ----------
SL_BUFFER_ATR=0.2
# stop is never closer than this % from entry (very tight stops = fees eat the profit)
MIN_SL_PCT=0.3
# SHORT: extra room above the sweeping candle high = 25% of the candle size
SWEEP_ROOM=0.25
TP1_R=2
TP2_R=3
TP1_CLOSE_PCT=50
USE_LIQUIDITY_TARGETS=true
MOVE_SL_TO_BE_AFTER_TP1=true

# ---------- other ----------
# no second signal on the same pair within 30 min
COOLDOWN_MINUTES=30
# ws (fast) or rest (polling). The bot switches to rest by itself if ws fails.
DATA_SOURCE=ws
# leave empty unless Binance changes its WebSocket address
WS_URL=
# optional, paid Coinglass plan; empty = not used
COINGLASS_API_KEY=
LOG_LEVEL=INFO
